# Chave de leitura do TMDB, usada para buscar os pôsteres pelo imdb_id dos filmes.
# Crie a sua em https://www.themoviedb.org/settings/api (opção "API Key (v3 auth)").
# Copie este arquivo para .env — sem a chave, os cards exibem o fallback "Pôster indisponível".
VITE_TMDB_API_KEY=

# De onde o site lê os vencedores:
#   api      → backend (http://localhost:3000/api) — padrão
#   planilha → src/data/category-awards.json (gerado da planilha, funciona sem backend)
VITE_DATA_SOURCE=api
